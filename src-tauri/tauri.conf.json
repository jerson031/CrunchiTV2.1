{
  "$schema": "https://tauri.app",
  "productName": "NextAnime TV",
  "version": "1.0.0",
  "identifier": "com.nextanime.tv",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NextAnime TV",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "decorations": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/*"
    ],
    "android": {
      "minSdkVersion": 24,
      "autoIncrementVersionCode": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}